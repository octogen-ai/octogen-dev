{
  "name": "@storerouter/cli",
  "version": "0.5.0",
  "description": "The StoreRouter CLI: coverage, lookup, and search from your terminal or your agent",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Octogen AI",
  "homepage": "https://github.com/octogen-ai/octogen-dev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octogen-ai/octogen-dev.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/octogen-ai/octogen-dev/issues"
  },
  "keywords": [
    "storerouter",
    "octogen",
    "cli",
    "commerce",
    "catalog",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "storerouter": "./dist/bin.js",
    "octogen": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "REFERENCE.md",
    "CONTRACT.md"
  ],
  "scripts": {
    "prebuild": "tsx --tsconfig tsconfig.json tools/check-contract.ts --check",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "octogen": "tsx src/bin.ts",
    "pretest": "tsx --tsconfig tsconfig.json tools/check-contract.ts --check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storerouter": "tsx src/bin.ts"
  },
  "dependencies": {
    "@octogen-ai/sdk": "0.7.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  }
}
