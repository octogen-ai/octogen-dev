{
  "name": "@octogen-ai/cli",
  "version": "0.1.0",
  "description": "The Octogen CLI: coverage, lookup, search, and voyages from your terminal or your agent",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Octogen AI",
  "homepage": "https://github.com/octogen-ai/octogen-dev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octogen-ai/octogen-dev.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/octogen-ai/octogen-dev/issues"
  },
  "keywords": [
    "octogen",
    "cli",
    "commerce",
    "catalog",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "octogen": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "octogen": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octogen-ai/sdk": "0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  }
}
